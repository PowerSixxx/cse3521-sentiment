import copy
import time
import random
import joblib
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

import torch
import torch.nn as nn

from pathlib import Path
from sklearn.base import clone
from sklearn.model_selection import train_test_split
from sklearn.utils.class_weight import compute_class_weight
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    classification_report,
    ConfusionMatrixDisplay
)

# Configuration
BASE_DIR = Path("C:/Users/andre/Downloads/3521PData")

DATA_PATH = BASE_DIR / "group_cleaned_seed44.csv"
MODEL_PATH = BASE_DIR / "logreg_tfidf.joblib"

OUTPUT_DIR = BASE_DIR / "ffnn_results"
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

SEED = 44
BATCH_SIZE = 256
EPOCHS = 50
LEARNING_RATE = 0.0001
WEIGHT_DECAY = 0.074989421
PATIENCE = 5

random.seed(SEED)
np.random.seed(SEED)
torch.manual_seed(SEED)

DEVICE = torch.device(
    "cuda" if torch.cuda.is_available() else "cpu"
)

print("Device:", DEVICE)

df = pd.read_csv(DATA_PATH)

X = df["Text"].astype(str).to_numpy()

y = df["Sentiment"].map({
    "negative": 0,
    "positive": 1
}).to_numpy()

# Reserve 20% for final testing
X_dev, X_test, y_dev, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=SEED,
    stratify=y
)

# Divide remaining 80% into training and validation
X_train, X_val, y_train, y_val = train_test_split(
    X_dev,
    y_dev,
    test_size=0.125,
    random_state=SEED,
    stratify=y_dev
)

print("Training samples:", len(X_train))
print("Validation samples:", len(X_val))
print("Testing samples:", len(X_test))

baseline = joblib.load(MODEL_PATH)

# Copy configuration without fitted vocabulary
tfidf = clone(baseline.named_steps["tfidf"])

# Fit only on training data
X_train = tfidf.fit_transform(X_train).astype(np.float32)
X_val = tfidf.transform(X_val).astype(np.float32)
X_test = tfidf.transform(X_test).astype(np.float32)

INPUT_DIM = X_train.shape[1]

print("TF-IDF input dimension:", INPUT_DIM)

joblib.dump(
    tfidf,
    OUTPUT_DIR / "ffnn_tfidf_vectorizer.joblib"
)

class SentimentFFNN(nn.Module):

    def __init__(self, input_dim):
        super().__init__()

        self.network = nn.Sequential(


            # Hidden layer 1
            nn.Linear(input_dim, 64),
            nn.ReLU(),
            nn.Dropout(p=0.30),

            # Hidden layer 2
            nn.Linear(64, 32),
            nn.ReLU(),
            nn.Dropout(p=0.20),

            # Output layer
            nn.Linear(32, 1)
        )

    def forward(self, x):
        return self.network(x).squeeze(-1)


model = SentimentFFNN(INPUT_DIM).to(DEVICE)

print(model)

print(
    "Trainable parameters:",
    sum(p.numel() for p in model.parameters()
        if p.requires_grad)
)

class_weights = compute_class_weight(
    class_weight="balanced",
    classes=np.array([0, 1]),
    y=y_train
)

class_weights = torch.tensor(
    class_weights,
    dtype=torch.float32,
    device=DEVICE
)

criterion = nn.BCEWithLogitsLoss(
    reduction="none"
)

optimizer = torch.optim.AdamW(
    model.parameters(),
    lr=LEARNING_RATE,
    weight_decay=WEIGHT_DECAY
)


def weighted_loss(logits, targets):

    losses = criterion(logits, targets)

    weights = class_weights[targets.long()]

    return (losses * weights).mean()
def get_batches(X, y, shuffle=False):

    indices = np.arange(len(y))

    if shuffle:
        np.random.shuffle(indices)

    for start in range(0, len(y), BATCH_SIZE):

        idx = indices[start:start + BATCH_SIZE]

        X_batch = torch.from_numpy(
            X[idx].toarray()
        ).to(DEVICE)

        y_batch = torch.tensor(
            y[idx],
            dtype=torch.float32,
            device=DEVICE
        )

        yield X_batch, y_batch

def train_epoch():

    model.train()

    total_loss = 0

    for X_batch, y_batch in get_batches(
        X_train, y_train, shuffle=True
    ):

        optimizer.zero_grad()

        logits = model(X_batch)

        loss = weighted_loss(logits, y_batch)

        loss.backward()

        optimizer.step()

        total_loss += loss.item() * len(y_batch)

    return total_loss / len(y_train)


def evaluate(X, y):

    model.eval()

    total_loss = 0
    probabilities = []

    with torch.no_grad():

        for X_batch, y_batch in get_batches(X, y):

            logits = model(X_batch)

            loss = weighted_loss(logits, y_batch)

            total_loss += loss.item() * len(y_batch)

            probs = torch.sigmoid(logits)

            probabilities.extend(
                probs.cpu().numpy()
            )

    probabilities = np.array(probabilities)

    predictions = (probabilities >= 0.5).astype(int)

    return total_loss / len(y), predictions


history = {
    "train_loss": [],
    "val_loss": [],
    "val_f1": []
}

best_val_loss = float("inf")
best_weights = None
best_epoch = 0
epochs_without_improvement = 0

start_time = time.perf_counter()

for epoch in range(EPOCHS):

    train_loss = train_epoch()

    val_loss, val_predictions = evaluate(
        X_val, y_val
    )

    val_f1 = f1_score(
        y_val,
        val_predictions,
        average="macro"
    )

    history["train_loss"].append(train_loss)
    history["val_loss"].append(val_loss)
    history["val_f1"].append(val_f1)

    print(
        f"Epoch {epoch + 1:02d}/{EPOCHS} | "
        f"Train Loss: {train_loss:.4f} | "
        f"Val Loss: {val_loss:.4f} | "
        f"Val F1: {val_f1:.4f}"
    )

    if val_loss < best_val_loss:

        best_val_loss = val_loss
        best_epoch = epoch + 1

        best_weights = copy.deepcopy(
            model.state_dict()
        )

        epochs_without_improvement = 0

    else:

        epochs_without_improvement += 1

        if epochs_without_improvement >= PATIENCE:

            print("Early stopping triggered.")
            break

training_time = time.perf_counter() - start_time

# Restore best performing model
model.load_state_dict(best_weights)

print("Best epoch:", best_epoch)
print(f"Training time: {training_time:.2f} seconds")

test_loss, y_pred = evaluate(X_test, y_test)

results = {
    "Model": "TF-IDF + FFNN",

    "Accuracy": accuracy_score(y_test, y_pred),

    "Precision": precision_score(
        y_test, y_pred, average="macro"
    ),

    "Recall": recall_score(
        y_test, y_pred, average="macro"
    ),

    "F1-score (Negative)": f1_score(
        y_test, y_pred, average="binary", pos_label=0
    ),

    "F1-score (Positive)": f1_score(
        y_test, y_pred, average="binary", pos_label=1
    ),

    "F1-score (Macro)": f1_score(
        y_test, y_pred, average="macro"
    ),

    "F1-score (Weighted)": f1_score(
        y_test, y_pred, average="weighted"
    ),

    "F1-score (Micro)": f1_score(
        y_test, y_pred, average="micro"
    ),

    "Training Time (s)": training_time
}

results_df = pd.DataFrame([results])

print("\nFinal Test Results:")
print(results_df.to_string(index=False))

print("\nClassification Report:")

print(classification_report(
    y_test,
    y_pred,
    target_names=["Negative", "Positive"]
))

results_df.to_csv(
    OUTPUT_DIR / "ffnn_metrics.csv",
    index=False
)


epochs = range(
    1, len(history["train_loss"]) + 1
)

plt.figure(figsize=(9, 5))

plt.plot(
    epochs,
    history["train_loss"],
    label="Training Loss",
    color="#BB0000",
    linewidth=2
)

plt.plot(
    epochs,
    history["val_loss"],
    label="Validation Loss",
    color="#666666",
    linewidth=2
)

plt.axvline(
    best_epoch,
    linestyle="--",
    color="black",
    label="Best Epoch"
)

plt.xlabel("Epoch")
plt.ylabel("Weighted Binary Cross-Entropy Loss")
plt.title("FFNN Training and Validation Loss")
plt.legend()
plt.grid(alpha=0.2)
plt.tight_layout()

plt.savefig(
    OUTPUT_DIR / "ffnn_loss_curves.png",
    dpi=300
)

plt.show()

pd.DataFrame(history).to_csv(
    OUTPUT_DIR / "ffnn_training_history.csv",
    index=False
)

ConfusionMatrixDisplay.from_predictions(
    y_test,
    y_pred,
    display_labels=["Negative", "Positive"],
    cmap="Reds"
)

plt.title("TF-IDF FFNN Confusion Matrix")
plt.tight_layout()

plt.savefig(
    OUTPUT_DIR / "ffnn_confusion_matrix.png",
    dpi=300
)

plt.show()

torch.save(
    {
        "model_state_dict": model.state_dict(),
        "input_dim": INPUT_DIM,
        "hidden_dims": [256, 128, 64],
        "dropout": [0.40, 0.30, 0.20],
        "best_epoch": best_epoch,
        "class_mapping": {
            0: "negative",
            1: "positive"
        }
    },
    OUTPUT_DIR / "ffnn_tfidf.pt"
)

print("Model and results saved to:", OUTPUT_DIR)
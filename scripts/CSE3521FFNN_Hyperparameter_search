# H. Negative precision-recall curves
# ------------------------------------------------------------

plt.figure(figsize=(9, 6))

negative_labels = (
    y_test == 0
).astype(int)

# One curve per unique trained model.
# Different thresholds do not change the PR curve.

for name, cached in test_cache.items():

    negative_probs = (
        1.0 - cached["probabilities"]
    )

    precision, recall, _ = precision_recall_curve(
        negative_labels,
        negative_probs
    )

    ap = average_precision_score(
        negative_labels,
        negative_probs
    )

    decay = cached["config"]["weight_decay"]

    plt.plot(
        recall,
        precision,
        linewidth=2,
        label=f"Decay={decay:.6f} (AP={ap:.4f})"
    )

plt.axhline(
    negative_labels.mean(),
    linestyle="--",
    color="black",
    label="Random baseline"
)

plt.xlabel("Negative Recall")
plt.ylabel("Negative Precision")
plt.title("Negative Sentiment Precision-Recall Curve")
plt.legend()
plt.grid(alpha=0.2)
